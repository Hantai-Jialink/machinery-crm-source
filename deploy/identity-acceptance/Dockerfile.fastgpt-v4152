# FastGPT v4.15.2 identity-poc 镜像（生产服务器构建专用副本）。
#
# 与 Dockerfile.fastgpt 的唯一差异：base 镜像从 node:24.16.0-alpine@sha256:... （Docker Hub
# 上不存在该精确 tag、阿里云加速器不认 digest）改为 node:22-alpine / node:22-bookworm-slim
# 纯 tag。FastGPT v4.15.2 源码 package.json 无 engines 锁定，官方镜像本身用 node20/22，
# 22-alpine 完全够用。构建逻辑、补丁测试、canvas 验证全部与原 Dockerfile 一致。
#
# 构建上下文必须是 FastGPT v4.15.2 源码 checkout（commit b9b6e23），由 build-fastgpt-v4152.sh
# 准备（clone + checkout + git apply v4.15.2 补丁）。

FROM node:22-alpine AS pnpm-toolchain
WORKDIR /app

ENV PNPM_VERSION=10.33.4
ENV PATH="/usr/local/bin:${PATH}"

# Remove any global pnpm/pnpx installation or shim inherited from the base
# image, then install one Corepack-owned shim at the front of lifecycle PATH.
RUN set -eux; \
    rm -rf /usr/local/lib/node_modules/pnpm; \
    rm -f /usr/local/bin/pnpm /usr/local/bin/pnpx; \
    corepack enable --install-directory /usr/local/bin; \
    corepack prepare "pnpm@${PNPM_VERSION}" --activate

# Keep these diagnostics visible in the Docker build log. The final check is a
# hard gate: dependency installation must never begin with another pnpm.
RUN set -eux; \
    node --version; \
    corepack --version; \
    command -v pnpm; \
    readlink -f "$(command -v pnpm)"; \
    pnpm --version; \
    actual_path="$(command -v pnpm)"; \
    resolved_path="$(readlink -f "$actual_path")"; \
    actual_version="$(pnpm --version)"; \
    if [ "$actual_version" != "$PNPM_VERSION" ]; then \
      echo "PNPM_VERSION_GATE=FAIL path=$actual_path resolved=$resolved_path expected=$PNPM_VERSION actual=$actual_version" >&2; \
      exit 1; \
    fi; \
    echo "PNPM_VERSION_GATE=PASS path=$actual_path resolved=$resolved_path version=$actual_version"

# MongoMemoryServer does not publish an Alpine/musl binary. Run only the
# trusted-identity patch tests in a Debian/glibc stage with the same Node and
# pnpm versions; none of this stage is copied into the application image.
FROM node:22-bookworm-slim AS identity-test-toolchain
WORKDIR /app

ENV PNPM_VERSION=10.33.4
ENV PATH="/usr/local/bin:${PATH}"

# Runtime libraries required by the MongoDB 7 binary downloaded by
# mongodb-memory-server. This stage is test-only and never reaches runner.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      libcurl4 \
      liblzma5 \
      libssl3 \
      zlib1g \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    rm -rf /usr/local/lib/node_modules/pnpm; \
    rm -f /usr/local/bin/pnpm /usr/local/bin/pnpx; \
    corepack enable --install-directory /usr/local/bin; \
    corepack prepare "pnpm@${PNPM_VERSION}" --activate

RUN set -eux; \
    node --version; \
    corepack --version; \
    command -v pnpm; \
    readlink -f "$(command -v pnpm)"; \
    pnpm --version; \
    actual_path="$(command -v pnpm)"; \
    resolved_path="$(readlink -f "$actual_path")"; \
    actual_version="$(pnpm --version)"; \
    if [ "$actual_version" != "$PNPM_VERSION" ]; then \
      echo "PNPM_TEST_VERSION_GATE=FAIL path=$actual_path resolved=$resolved_path expected=$PNPM_VERSION actual=$actual_version" >&2; \
      exit 1; \
    fi; \
    echo "PNPM_TEST_VERSION_GATE=PASS path=$actual_path resolved=$resolved_path version=$actual_version"

FROM identity-test-toolchain AS identity-tests

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig.json ./
COPY ./packages ./packages
COPY ./sdk ./sdk
COPY ./test ./test
COPY ./projects/app ./projects/app

# identity-tests 只跑身份隔离单元测试（context.test.ts，验 AsyncLocalStorage），
# 用不到 canvas 画图。这个 stage 继承 bookworm-slim、未装 python3/g++/cairo-dev，
# canvas 的 prebuild-install/node-gyp 会因找不到 Python 而失败拖垮整个构建。
# --ignore-scripts 跳过所有 install 脚本（canvas 不编译），测试照常跑。
# 最终运行镜像的 canvas 走 maindeps stage（alpine+完整工具链）正常编译，不受影响。
RUN pnpm install --frozen-lockfile --ignore-scripts

# v4.15.2 特有：context.test.ts 的 import 链路间接引用 @fastgpt-sdk/sandbox-adapter
#（packages/service/core/ai/sandbox/infrastructure/volume/service.ts），该子包 main/exports
# 指向 ./dist/*，但 workspace 源码 clone 下来 dist 不存在，必须 tsdown 构建（非 postinstall）。
# 不构建则 vite packageEntryFailure、测试套件 0 test 加载失败。v4.15.1 当时此 import 链不存在
# 故原 Dockerfile 无此步。tsdown 为纯 JS 打包工具，bookworm-slim 可跑，不依赖 canvas。
# build:sdks = `pnpm -r --filter @fastgpt-sdk/storage --filter @fastgpt-sdk/otel --filter @fastgpt-sdk/sandbox-adapter build`
RUN pnpm build:sdks

RUN cd packages/service \
    && pnpm exec vitest run -c vitest.config.ts \
      test/core/workflow/utils/context.test.ts \
      --coverage=false \
    && touch /identity-tests-passed

# --------- install dependencies -----------
FROM pnpm-toolchain AS maindeps

ARG proxy

RUN [ -z "$proxy" ] || sed -i 's/dl-cdn.alpinelinux.org/mirrors.ustc.edu.cn/g' /etc/apk/repositories
ENV PYTHON=/usr/bin/python3
ENV npm_config_python=/usr/bin/python3
ENV npm_config_nodedir=/usr/local

# canvas has no prebuilt binary for this Alpine/musl target. Keep its native
# compilation toolchain confined to this build-only dependency stage.
RUN apk add --no-cache \
      libc6-compat \
      python3 \
      make \
      g++ \
      pkgconf \
      cairo-dev \
      pango-dev \
      libjpeg-turbo-dev \
      giflib-dev \
      librsvg-dev \
      pixman-dev

RUN set -eux; \
    python3 --version; \
    command -v python3; \
    g++ --version; \
    pkg-config --version; \
    pkg-config --modversion cairo; \
    pkg-config --modversion pango; \
    test "$PYTHON" = "/usr/bin/python3"; \
    test "$npm_config_python" = "/usr/bin/python3"
RUN test -f "$npm_config_nodedir/include/node/node.h"

COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY ./packages ./packages
COPY ./sdk ./sdk
COPY ./projects/app/package.json ./projects/app/package.json

RUN [ -f pnpm-lock.yaml ] || (echo "Lockfile not found." && exit 1)

RUN if [ -z "$proxy" ]; then \
      pnpm install --frozen-lockfile; \
    else \
      pnpm install --frozen-lockfile --registry=https://registry.npmmirror.com; \
    fi

# --------- builder -----------
FROM pnpm-toolchain AS builder

ARG proxy
ARG base_url

COPY package.json pnpm-workspace.yaml .npmrc tsconfig.json eslint.config.mjs ./
COPY --from=maindeps /app/node_modules ./node_modules
COPY --from=maindeps /app/packages ./packages
COPY --from=maindeps /app/sdk ./sdk
COPY ./projects/app ./projects/app
COPY --from=maindeps /app/projects/app/node_modules ./projects/app/node_modules
COPY --from=identity-tests /identity-tests-passed /identity-tests-passed

RUN [ -z "$proxy" ] || sed -i 's/dl-cdn.alpinelinux.org/mirrors.ustc.edu.cn/g' /etc/apk/repositories
RUN apk add --no-cache \
      libc6-compat \
      cairo \
      pango \
      libjpeg-turbo \
      giflib \
      librsvg \
      pixman

ENV NODE_OPTIONS="--max-old-space-size=4096"
ENV NEXT_PUBLIC_BASE_URL=$base_url

RUN pnpm build:sdks
RUN pnpm --filter=app build

RUN rm -rf projects/app/.next/standalone/node_modules/.pnpm/@next+rspack-binding-*/ \
    projects/app/.next/standalone/node_modules/.pnpm/@rspack+binding-*/ \
    projects/app/.next/standalone/node_modules/.pnpm/next-rspack*/ \
    projects/app/.next/standalone/node_modules/.pnpm/typescript@*/ \
    projects/app/.next/standalone/node_modules/.pnpm/*-linux-x64-gnu@*/ \
    projects/app/.next/standalone/node_modules/.pnpm/@img+sharp-libvips-linux-x64@*/

# --------- runner -----------
FROM node:22-alpine AS runner
WORKDIR /app

ARG proxy
ARG base_url

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

RUN [ -z "$proxy" ] || sed -i 's/dl-cdn.alpinelinux.org/mirrors.ustc.edu.cn/g' /etc/apk/repositories
RUN apk add --no-cache \
      curl \
      ca-certificates \
      libc++ \
      cairo \
      pango \
      libjpeg-turbo \
      giflib \
      librsvg \
      pixman \
  && update-ca-certificates

COPY --from=builder /app/projects/app/public /app/projects/app/public
COPY --from=builder /app/projects/app/next.config.ts /app/projects/app/next.config.ts
COPY --from=builder /app/projects/app/next-i18next.config.js /app/projects/app/next-i18next.config.js
COPY --from=builder --chown=nextjs:nodejs /app/projects/app/.next/standalone /app/
COPY --from=builder --chown=nextjs:nodejs /app/projects/app/.next/static /app/projects/app/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/packages/web/i18n /app/packages/web/i18n
COPY --from=builder --chown=nextjs:nodejs /app/projects/app/.next/server/chunks /app/projects/app/.next/server/chunks
COPY --from=builder --chown=nextjs:nodejs /app/projects/app/worker /app/projects/app/worker
COPY --from=builder --chown=nextjs:nodejs /app/projects/app/worker /app/worker

# Next standalone does not trace the optional canvas package. Copy the exact
# native package built in maindeps so the runtime gate can load it directly.
COPY --from=maindeps --chown=nextjs:nodejs /app/node_modules/.pnpm/canvas@3.2.3/node_modules/canvas /app/node_modules/canvas
COPY --from=maindeps /app/node_modules/@zilliz/milvus2-sdk-node ./node_modules/@zilliz/milvus2-sdk-node

COPY --from=builder /app/projects/app/package.json ./package.json
COPY --chown=nextjs:nodejs ./projects/app/data/test.mp3 /app/data/test.mp3
COPY --chown=nextjs:nodejs ./projects/app/data/GeoLite2-City.mmdb /app/data/GeoLite2-City.mmdb

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV NEXT_PUBLIC_BASE_URL=$base_url

EXPOSE 3000

USER nextjs

ENTRYPOINT ["node","--max-old-space-size=4096","./projects/app/server.js"]
