# 只填写生产值到受限文件 .env.production；不得提交、上传或粘贴密钥。
NODE_ENV=production
PORT=3010
HOSTNAME=0.0.0.0
MCP_IMAGE=REPLACE_WITH_ARTIFACT_MCP_REPO_TAG
MCP_IMAGE_ARCHIVE=/secure/REPLACE_WITH_MCP_DOCKER_ARCHIVE
MCP_IMAGE_IDENTITY_PROOF=./mcp-image-archive-manifest.json
PRODUCTION_ENV_FILE=./.env.production

# 现有 CRM/ERP 与最小数据库权限账户。
CRM_DATABASE=machinery_crm
DATABASE_URL=REPLACE_WITH_PRODUCTION_BUSINESS_READONLY_DATABASE_URL
MCP_AUDIT_DATABASE_URL=REPLACE_WITH_OPERATION_LOG_INSERT_ONLY_DATABASE_URL
MYSQL_CLIENT_DEFAULTS_FILE=REPLACE_WITH_EXISTING_RESTRICTED_MYSQL_CLIENT_CONFIG
MCP_AUDIT_MYSQL_CLIENT_DEFAULTS_FILE=REPLACE_WITH_AUDIT_ACCOUNT_MYSQL_CLIENT_CONFIG
MYSQL_CLIENT_IMAGE=mysql:8.0.44@sha256:f7878bec832c6be5e61c39d3949651be8aa977daf875089b4560ae1434d2cb9c
MCP_DATABASE_GRANT_HOST=REPLACE_WITH_ACTUAL_DOCKER_SOURCE_HOST
MCP_DATABASE_READ_USER=dachuan_mcp_read
MCP_DATABASE_AUDIT_USER=dachuan_mcp_audit
AUTH_SECRET=REPLACE_WITH_EXISTING_CRM_AUTH_SECRET
AUTH_URL=REPLACE_WITH_EXISTING_CRM_ORIGIN
MCP_AUDIT_USER_ID=REPLACE_WITH_EXISTING_SUPER_ADMIN_USER_ID

# MCP 服务身份与灰度工具限制。
MCP_API_KEYS_JSON=REPLACE_WITH_HASHED_MCP_SERVICE_KEY_JSON
MCP_LEGACY_USER_BOUND_AUTH=false
MCP_TOOL_MODE=FULL_READ_ONLY
MCP_TOOL_ALLOWLIST=dachuan_identity_who_am_i,crm_customer_get,crm_contract_get
MCP_QUERY_TIMEOUT_MS=5000
MCP_ALLOWED_HOSTS=REPLACE_WITH_MCP_HOST
MCP_ALLOWED_ORIGINS=REPLACE_WITH_FASTGPT_CANARY_ORIGIN

# Gateway：仅超级管理员、短期 Ed25519 断言与专用 Redis。
REDIS_PASSWORD=REPLACE_WITH_DEDICATED_AGENT_AUTH_REDIS_PASSWORD
AGENT_AUTH_ISSUER=REPLACE_WITH_CRM_ISSUER
AGENT_AUTH_AUDIENCE=REPLACE_WITH_PRODUCTION_MCP_AUDIENCE
AGENT_AUTH_TOKEN_TTL_SECONDS=600
AGENT_AUTH_ACTIVE_KID=REPLACE_WITH_ACTIVE_KID
AGENT_AUTH_KEYS_JSON=REPLACE_WITH_ED25519_KEYSET
AGENT_AUTH_REDIS_URL=redis://:REPLACE_WITH_DEDICATED_AGENT_AUTH_REDIS_PASSWORD@dachuanpro-mcp-redis:6379
AGENT_AUTH_REDIS_PREFIX=dachuan:agent-auth:prod
AGENT_GATEWAY_FASTGPT_CHAT_URL=REPLACE_WITH_FASTGPT_4152_CANARY_INTERNAL_CHAT_URL
AGENT_GATEWAY_FASTGPT_API_KEY=REPLACE_WITH_DEDICATED_FASTGPT_AGENT_KEY
AGENT_GATEWAY_MAX_REQUEST_BYTES=1048576
AGENT_GATEWAY_RATE_LIMIT_PER_MINUTE=10
AGENT_GATEWAY_ALLOWED_ORIGINS=REPLACE_WITH_EXISTING_CRM_ORIGIN
AGENT_GATEWAY_ALLOWED_ROLES=SUPER_ADMIN

# 仅用于预检查、备份和健康检查；不写入应用容器。
FORMAL_FASTGPT_HEALTH_URL=http://127.0.0.1:3100
FASTGPT_CANARY_HEALTH_URL=http://127.0.0.1:3110
FASTGPT_CANARY_COMPATIBILITY_PROOF=./fastgpt-v4.15.2-compatibility.json
FASTGPT_SOURCE_COMMIT=b9b6e2305e70823c9706291de4b19c4dc3ae05f6
FASTGPT_BASE_IMAGE=ghcr.io/labring/fastgpt:v4.15.2@sha256:8f09f9dd41c17aecec6bbe69a332432fdf4e686546f050d65e670bda60aa2033
FASTGPT_CANARY_IMAGE=REPLACE_WITH_ARTIFACT_FASTGPT_REPO_TAG
FASTGPT_CANARY_ARCHIVE=/secure/REPLACE_WITH_FASTGPT_CANARY_DOCKER_ARCHIVE
FASTGPT_CANARY_AGENT_ENGINE=fastAgent
# Canary 独享 Mongo、Redis、对象存储、应用、用户、会话与 API Key；绝不复用正式值。
CANARY_MONGO_ROOT_USER=REPLACE_WITH_CANARY_MONGO_USER
CANARY_MONGO_ROOT_PASSWORD=REPLACE_WITH_CANARY_MONGO_PASSWORD
CANARY_MONGO_DATABASE=dachuan_fastgpt_canary_4152
CANARY_MONGO_REPLICA_KEY_FILE=/secure/REPLACE_WITH_CANARY_MONGO_REPLICA_KEY_FILE
CANARY_REDIS_PASSWORD=REPLACE_WITH_CANARY_REDIS_PASSWORD
CANARY_MINIO_ROOT_USER=REPLACE_WITH_CANARY_MINIO_USER
CANARY_MINIO_ROOT_PASSWORD=REPLACE_WITH_CANARY_MINIO_PASSWORD
CANARY_STORAGE_PUBLIC_BUCKET=dachuan-fastgpt-canary-4152-public
CANARY_STORAGE_PRIVATE_BUCKET=dachuan-fastgpt-canary-4152-private
CANARY_FASTGPT_ROOT_PASSWORD=REPLACE_WITH_CANARY_ROOT_PASSWORD
CANARY_FASTGPT_ROOT_KEY=REPLACE_WITH_CANARY_ROOT_KEY
CANARY_FASTGPT_TOKEN_KEY=REPLACE_WITH_CANARY_TOKEN_KEY
CANARY_FASTGPT_FILE_TOKEN_KEY=REPLACE_WITH_CANARY_FILE_TOKEN_KEY
CANARY_FASTGPT_AES_KEY=REPLACE_WITH_CANARY_AES_KEY
CANARY_FASTGPT_INVOKE_TOKEN_SECRET=REPLACE_WITH_CANARY_INVOKE_TOKEN_SECRET
CANARY_AIPROXY_IMAGE=ghcr.io/labring/aiproxy:v0.6.5@sha256:e96073363ac3e38fd0c28b7653aa18916e93c57a688452450c619023b7811e4d
CANARY_AIPROXY_ADMIN_KEY=REPLACE_WITH_CANARY_AIPROXY_ADMIN_KEY
CANARY_AIPROXY_POSTGRES_PASSWORD=REPLACE_WITH_CANARY_AIPROXY_POSTGRES_PASSWORD
CANARY_MODEL_UPSTREAM_ENDPOINT=REPLACE_WITH_CANARY_DEDICATED_MODEL_ENDPOINT
CANARY_MODEL_UPSTREAM_API_KEY=REPLACE_WITH_CANARY_DEDICATED_MODEL_API_KEY
FASTGPT_DIR=/opt/fastgpt
CRM_DIR=REPLACE_WITH_EXISTING_CRM_RELEASE_DIRECTORY
NGINX_GATEWAY_INCLUDE=REPLACE_WITH_NEW_NGINX_INCLUDE_PATH
BACKUP_ROOT=/opt/crm-backups

# 由服务器管理员对各正式/Canary资源标识计算 SHA256；只填摘要，必须两两不同。
FORMAL_FASTGPT_MONGO_FINGERPRINT=REPLACE_WITH_SHA256
CANARY_FASTGPT_MONGO_FINGERPRINT=REPLACE_WITH_SHA256
FORMAL_FASTGPT_REDIS_FINGERPRINT=REPLACE_WITH_SHA256
CANARY_FASTGPT_REDIS_FINGERPRINT=REPLACE_WITH_SHA256
FORMAL_FASTGPT_OBJECT_STORAGE_FINGERPRINT=REPLACE_WITH_SHA256
CANARY_FASTGPT_OBJECT_STORAGE_FINGERPRINT=REPLACE_WITH_SHA256
FORMAL_FASTGPT_APP_FINGERPRINT=REPLACE_WITH_SHA256
CANARY_FASTGPT_APP_FINGERPRINT=REPLACE_WITH_SHA256
FORMAL_FASTGPT_USER_FINGERPRINT=REPLACE_WITH_SHA256
CANARY_FASTGPT_USER_FINGERPRINT=REPLACE_WITH_SHA256
FORMAL_FASTGPT_SESSION_FINGERPRINT=REPLACE_WITH_SHA256
CANARY_FASTGPT_SESSION_FINGERPRINT=REPLACE_WITH_SHA256
FORMAL_FASTGPT_API_KEY_FINGERPRINT=REPLACE_WITH_SHA256
CANARY_FASTGPT_API_KEY_FINGERPRINT=REPLACE_WITH_SHA256
FORMAL_FASTGPT_AI_PROXY_FINGERPRINT=REPLACE_WITH_SHA256
CANARY_FASTGPT_AI_PROXY_FINGERPRINT=REPLACE_WITH_SHA256
FORMAL_FASTGPT_MODEL_SERVICE_FINGERPRINT=REPLACE_WITH_SHA256
CANARY_FASTGPT_MODEL_SERVICE_FINGERPRINT=REPLACE_WITH_SHA256
